{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/c++.exe; if ($?) { cmake --build build }",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "./build/ipp.exe src/init.ippl",
      "options": { "env": { "PATH": "C:/msys64/ucrt64/bin;${env:PATH}" } },
      "dependsOn": "build-debug",
      "problemMatcher": []
    }
  ]
}
